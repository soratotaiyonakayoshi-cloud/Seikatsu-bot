# このファイルを .env にコピーして値を入れる: cp .env.example .env
# 値はクォート不要。= の前後にスペースを入れないこと。

# Discord Botのトークン（Developer Portal > Bot > Reset Token）
DISCORD_BOT_TOKEN=ここにトークン

# 記録DB(SQLite)のファイル名。VM上なら既定のままでOK
DB_PATH=seikatsu.db

# 毎晩の判定時刻（時, 0-23）。この時刻に「最低限」未達の人が #こら に晒される
JUDGE_HOUR=23

# 起床締切の操作猶予（分）。起きてからボタンを押すまでのタイムラグはこの分数まで寝坊扱いにしない
WAKE_GRACE_MIN=5

# 叱り用カスタム絵文字の名前（サーバーに同名の絵文字を登録しておく。無ければ 👹 で代用）
KORA_EMOJI=こら
# 達成した人に付けるカスタム絵文字の名前（無ければ ✨ で代用）
ERAI_EMOJI=えらい

# 朝のラジオ体操：開始時刻(HH:MM)と音源ファイル（VMに直接置く。リポジトリには含めない）
RADIO_TIME=06:30
RADIO_MP3=radio.mp3

# 課題リマインドを流す時刻（時, 0-23）。3日前・前日・当日のこの時刻に未完了の人へ通知
REMIND_HOUR=8

# みんなで暗記！！(gakushu-rpg) 連携：達成した日に🎫メダル付与＆🌅生活ランキング。空なら送信しない
# Cloudflare側の `wrangler pages secret put VC_SECRET` と同じ値を入れる
GAKUSHU_URL=https://gakushu-rpg.pages.dev
GAKUSHU_SECRET=

# 朝の天気の地点（Open-Meteo・キー不要）。既定=府中キャンパス付近。小金井なら 35.70 / 139.50
WEATHER_LAT=35.68
WEATHER_LON=139.48

# 新規参加者を #はじめに📖 で自動歓迎する場合は 1（Developer Portal で SERVER MEMBERS INTENT を ON にしてから）
MEMBERS_INTENT=1