# このファイルを .env にコピーして値を入れる: cp .env.example .env
# 値はクォート不要。= の前後にスペースを入れないこと。

# Discord Botのトークン（Developer Portal > Bot > Reset Token）
DISCORD_BOT_TOKEN=ここにトークン

# 記録DB(SQLite)のファイル名。VM上なら既定のままでOK
DB_PATH=seikatsu.db

# 毎晩の判定時刻（時, 0-23）。この時刻に「最低限」未達の人が #こら に晒される
JUDGE_HOUR=23

# 叱り用カスタム絵文字の名前（サーバーに同名の絵文字を登録しておく。無ければ 👹 で代用）
KORA_EMOJI=こら
